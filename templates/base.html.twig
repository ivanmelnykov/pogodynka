<!DOCTYPE html>
<html>
    <head>

        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
        <style>

            body {
                background-color: #ffffff;
            }
            .main-container {
                padding-left: 3rem;
                padding-top: 1rem;
                max-width: 800px;
            }


            .btn-link-action {
                padding: 0;
                border: none;
                background: none;
                color: #0d6efd;
                text-decoration: underline;
                cursor: pointer;
            }
            .btn-link-action:hover {
                color: #0a58ca;
            }
            .form-label {
                margin-bottom: 0.25rem;
                color: #212529;
            }


            .invalid-feedback {
                color: #dc3545;
            }
        </style>



        {% block stylesheets %}
        {% endblock %}


        {% set frankenphp_hot_reload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphp_hot_reload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphp_hot_reload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <nav class="navbar navbar-expand-lg navbar-light bg-light" style="background-color: #f8f9fa !important; border-bottom: 1px solid #dee2e6; padding: 0.5rem 3rem;">
        <div class="container-fluid p-0">
            <a class="navbar-brand fw-bold" href="#">App</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') starts with 'app_location' %}text-dark fw-bold{% else %}text-secondary{% endif %}"
                           href="{{ path('app_location_index') }}">Cities</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') starts with 'app_forecast' %}text-dark fw-bold{% else %}text-secondary{% endif %}"
                           href="{{ path('app_forecast_index') }}">Forecasts</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <body>


    <div class="main-container">
        {% block body %}{% endblock %}
    </div>

    s
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    {% block javascripts %}{% endblock %}



    </body>
</html>
