{% extends 'base.html.twig' %}

{% block title %}Forecast{% endblock %}

{% block body %}
    <h1>Forecast</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ forecast.id }}</td>
            </tr>
            <tr>
                <th>Date</th>
                <td>{{ forecast.date ? forecast.date|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Temperature</th>
                <td>{{ forecast.temperature }}</td>
            </tr>
            <tr>
                <th>Wind</th>
                <td>{{ forecast.wind }}</td>
            </tr>
            <tr>
                <th>Humidity</th>
                <td>{{ forecast.humidity }}</td>
            </tr>
            <tr>
                <th>Chance_of_preticipation</th>
                <td>{{ forecast.chanceOfPreticipation }}</td>
            </tr>
        </tbody>
    </table>


    <a href="{{ path('app_forecast_index') }}">Back to list</a>

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_forecast_edit', {'id': forecast.id}) }}">Edit</a>
    {% endif %}

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_forecast_edit', {'id': forecast.id}) }}">Delete</a>
    {% endif %}
{% endblock %}
